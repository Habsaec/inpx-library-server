---
// Starlight's header hides the social links, theme and language pickers below 50rem
// (they live only in the sidebar menu, and splash pages have no menu at all).
// This copy keeps them in the header on phones, as compact icon-only controls.
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex"><SiteTitle /></div>
	<div class="sl-flex print:hidden search-wrapper">{shouldRenderSearch && <Search />}</div>
	<div class="sl-flex print:hidden right-group">
		<div class="sl-flex social-icons"><SocialIcons /></div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	/* Phones and small tablets: icon-only pickers, tighter spacing. */
	@media (max-width: 49.99rem) {
		.header {
			gap: 0.5rem;
		}
		.search-wrapper {
			margin-inline-start: auto;
		}
		.right-group,
		.social-icons {
			gap: 0.625rem;
		}
		.social-icons::after {
			display: none;
		}
		.right-group :global(label) {
			--sl-caret-size: 0rem;
			--sl-label-icon-size: 1rem;
			width: 1.75rem;
			height: 2.25rem;
			justify-content: center;
		}
		.right-group :global(label .caret) {
			display: none;
		}
		.right-group :global(label .label-icon) {
			position: static;
			transform: none;
			font-size: 1.1rem;
		}
		/* The native <select> stays tappable over the icon but shows no text. */
		.right-group :global(select) {
			position: absolute;
			inset: 0;
			width: 100%;
			margin: 0;
			padding: 0;
			opacity: 0;
		}
	}

	/* Narrow phones: logo only, the name is in the page itself. */
	@media (max-width: 30rem) {
		.title-wrapper :global(.site-title span) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				1fr
				auto;
			align-content: center;
		}
	}
</style>
